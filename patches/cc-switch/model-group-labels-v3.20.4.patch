diff --git a/src/components/providers/forms/shared/ModelDropdown.tsx b/src/components/providers/forms/shared/ModelDropdown.tsx
index 2ed4b1d..cc988fd 100644
--- a/src/components/providers/forms/shared/ModelDropdown.tsx
+++ b/src/components/providers/forms/shared/ModelDropdown.tsx
@@ -17,6 +17,30 @@ import {
 } from "@/components/ui/popover";
 import type { FetchedModel } from "@/lib/api/model-fetch";
 
+function getModelLabel(model: FetchedModel): string {
+  if (!model.ownedBy) return model.id;
+  const separator = model.id.indexOf("/");
+  const groupEnd = model.id.indexOf("/", separator + 1);
+  if (separator < 0 || groupEnd < 0) return model.id;
+
+  // skapihub keeps the route in the ID and the readable group in ownedBy.
+  // Only shorten a matching route; keep other providers' model IDs intact.
+  const routeGroup = model.id.slice(0, groupEnd);
+  const readableGroup = routeGroup
+    .split("/")
+    .map((part) => {
+      const label = part.replace(/@[0-9a-f]{32}$/, "");
+      try {
+        return decodeURIComponent(label);
+      } catch {
+        return label;
+      }
+    })
+    .join("/");
+  if (readableGroup !== model.ownedBy) return model.id;
+  return model.id.slice(groupEnd + 1) || model.id;
+}
+
 export function ModelDropdown({
   models,
   onSelect,
@@ -80,13 +104,13 @@ export function ModelDropdown({
                     value={m.id}
                     // Expose the vendor name as a keyword so models can also be
                     // fuzzy-matched by vendor, not just by model id.
-                    keywords={[m.ownedBy || "Other"]}
+                    keywords={[m.ownedBy || "Other", getModelLabel(m)]}
                     onSelect={() => {
                       onSelect(m.id);
                       setOpen(false);
                     }}
                   >
-                    {m.id}
+                    {getModelLabel(m)}
                   </CommandItem>
                 ))}
               </CommandGroup>
